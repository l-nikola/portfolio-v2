---
import { contact } from "@/config/contact";
import { Mail, Phone } from "@lucide/astro";

interface Props {
  type: "phone" | "email";
}
const { type } = Astro.props;

const isEmail = type === "email";

const href = isEmail ? `mailto:${contact.email}` : `tel:${contact.phone.link}`;

const label = isEmail ? contact.email : contact.phone.display;

const Icon = isEmail ? Mail : Phone;
const ariaLabel = isEmail ? "Envoyer un email" : "Appeler par téléphone";
---

<a
  href={href}
  aria-label={ariaLabel}
  class="border-gradient-solid flex w-full items-center justify-center gap-1.5 rounded-full py-2.5 md:py-2"
>
  <Icon class="h-4 w-4 md:h-6 md:w-6" stroke-width={1} />
  <span class="text-xs md:text-sm">{label}</span>
</a>
